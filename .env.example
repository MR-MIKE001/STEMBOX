# Copy to .env and change what you need. Every setting is optional.

# Network: 0.0.0.0 = reachable from other devices on the Wi-Fi.
STEMBOX_HOST=0.0.0.0
STEMBOX_PORT=5000

# Where uploads, the database and the secret key are kept (back this folder up).
# STEMBOX_STORAGE_DIR=/home/pi/stembox-data
# STEMBOX_DATABASE=/home/pi/stembox-data/stembox.db
# STEMBOX_PACKAGES_DIR=/home/pi/stembox-packages

# Leave empty to auto-generate one (kept in STORAGE_DIR/secret_key).
# STEMBOX_SECRET_KEY=

STEMBOX_SITE_NAME=STEMBox

# Upload limits in megabytes.
STEMBOX_MAX_PDF_MB=50
STEMBOX_MAX_IMAGE_MB=10
STEMBOX_MAX_AUDIO_MB=100
STEMBOX_MAX_VIDEO_MB=500
STEMBOX_MAX_PACKAGE_MB=2048

# Seconds to wait when pulling content from another STEMBox over Wi-Fi.
STEMBOX_SYNC_TIMEOUT=600
